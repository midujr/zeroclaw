# syntax=docker/dockerfile:1
#
# Dockerfile.timeweb — ZeroClaw для Timeweb App Platform
#
# Отличия от оригинального Dockerfile:
#   - Используем debian-slim вместо distroless (чтобы работал healthcheck и были утилиты для отладки)
#   - Генерируем config.toml из переменных окружения при старте через entrypoint-скрипт
#   - Все логи идут в stdout/stderr
#   - Нет volumes (Timeweb их не поддерживает в docker-compose)

# ── Stage 1: Build ──────────────────────────────────────────────
FROM rust:1.93-slim-trixie AS builder

WORKDIR /app

# Установка зависимостей сборки
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# 1. Кеширование зависимостей — копируем только манифесты
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release --locked 2>&1 || cargo build --release 2>&1
RUN rm -rf src

# 2. Сборка проекта
COPY . .
RUN touch src/main.rs
RUN cargo build --release 2>&1 && \
    strip target/release/zeroclaw || true

# ── Stage 2: Runtime ────────────────────────────────────────────
FROM debian:trixie-slim AS runtime

# Утилиты для отладки и healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/*

# Копируем бинарник
COPY --from=builder /app/target/release/zeroclaw /usr/local/bin/zeroclaw

# Создаём пользователя и рабочие директории
RUN useradd -m -u 1000 -s /bin/sh zeroclaw && \
    mkdir -p /zeroclaw-data/workspace /zeroclaw-data/.zeroclaw && \
    chown -R zeroclaw:zeroclaw /zeroclaw-data

# Копируем entrypoint-скрипт
COPY --chmod=755 entrypoint.sh /entrypoint.sh

# Переменные окружения
ENV HOME=/zeroclaw-data
ENV ZEROCLAW_WORKSPACE=/zeroclaw-data/workspace
ENV ZEROCLAW_GATEWAY_PORT=3000
ENV RUST_LOG=info,zeroclaw=debug
ENV RUST_BACKTRACE=1

WORKDIR /zeroclaw-data
USER zeroclaw

EXPOSE 3000

# Tini — правильный PID 1, корректно обрабатывает сигналы
ENTRYPOINT ["tini", "--", "/entrypoint.sh"]
CMD ["gateway"]
